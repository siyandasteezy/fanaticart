---
import Ph from './Ph.astro';
import { site } from '../data/site';
---

<section class="hero" aria-labelledby="hero-h">
  <div class="hero__media media scrim">
    <Ph
      name="hero-performance"
      alt=""
      priority
      sizes="100vw"
      widths={[640, 960, 1400, 1920, 2400, 2800]}
    />
  </div>

  <div class="hero__body wrap">
    <p class="hero__eyebrow">Multidisciplinary arts education &amp; creative enterprise</p>
    <h1 class="display display--xl" id="hero-h">
      Purpose.<br />Excellence.<br />Creative Futures.
    </h1>
    <p class="hero__lede">{site.description}</p>
    <div class="hero__actions">
      <a class="btn btn--gold" href="/contact/">Join Fanatic Arts <span class="arw" aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" href="/disciplines/">Explore the disciplines</a>
    </div>
  </div>

  <a class="hero__scroll" href="#what-we-do" aria-label="Scroll to what Fanatic Arts does">
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    color: var(--paper);
    isolation: isolate;
    overflow: clip;
  }
  .hero__media { position: absolute; inset: 0; z-index: -1; }
  /* The headline is gold — a mid-luminance colour — so the light beams behind it
     have to be held down or the letterforms disappear into them. Weighted to the
     band the type actually occupies, easing off at the top so the beams still read. */
  .hero__media.scrim::after {
    background: linear-gradient(
      to top,
      rgb(6 5 4 / 0.92) 0%,
      rgb(6 5 4 / 0.82) 22%,
      rgb(6 5 4 / 0.8) 48%,
      rgb(6 5 4 / 0.72) 72%,
      rgb(6 5 4 / 0.44) 90%,
      rgb(6 5 4 / 0.52) 100%
    );
  }
  .hero__media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 58%; }

  .hero__body {
    padding-block: clamp(7rem, 18vh, 11rem) clamp(5rem, 13vh, 8rem);
    display: grid;
    gap: clamp(1.1rem, 2.2vw, 1.9rem);
    max-width: min(var(--maxw), 100%);
  }
  .hero__eyebrow {
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--paper);
  }
  .hero h1 { max-width: 14ch; color: var(--gold-300); }
  .hero__lede {
    max-width: 52ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: color-mix(in srgb, var(--paper) 82%, transparent);
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 0.5rem; }

  .hero__scroll {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(5rem, 13vh, 8rem);
    display: none;
    width: 1px;
    height: clamp(4rem, 9vh, 7rem);
    background: color-mix(in srgb, var(--paper) 28%, transparent);
    overflow: hidden;
  }
  .hero__scroll-line {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 45%;
    background: var(--gold-300);
    animation: drop 2.4s var(--ease) infinite;
  }
  @keyframes drop {
    0%   { transform: translateY(-100%); }
    60%  { transform: translateY(220%); }
    100% { transform: translateY(220%); }
  }
  @media (min-width: 62rem) { .hero__scroll { display: block; } }
  @media (prefers-reduced-motion: reduce) { .hero__scroll-line { animation: none; transform: none; } }
</style>
