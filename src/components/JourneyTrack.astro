---
import Ph from './Ph.astro';
import { journey } from '../data/journey';
---

<div class="jt">
  <ol class="jt__track" tabindex="0" role="region" aria-label="The creative journey, scrollable">
    {journey.map((s) => (
      <li class="jt__step">
        {/* tabindex makes the hover-revealed caption reachable by keyboard too. */}
        <figure class="jt__card" tabindex="0">
          <span class="jt__media media media--zoom">
            <Ph
              name={s.photo}
              alt={s.body}
              sizes="(min-width: 62rem) 30vw, (min-width: 40rem) 46vw, 78vw"
              widths={[380, 560, 760, 1000, 1400]}
            />
          </span>
          <figcaption class="jt__body">
            <span class="jt__n">{s.n}</span>
            <h3 class="display display--s">{s.title}</h3>
            <p>{s.body}</p>
          </figcaption>
        </figure>
      </li>
    ))}
  </ol>
  <p class="jt__hint" aria-hidden="true">Scroll →</p>
</div>

<style>
  .jt { position: relative; }
  .jt__track {
    list-style: none;
    margin: 0;
    padding: 0 var(--gutter) 1.25rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(78vw, 24rem);
    gap: clamp(0.9rem, 2vw, 1.75rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--gold) transparent;
  }
  .jt__track::-webkit-scrollbar { height: 3px; }
  .jt__track::-webkit-scrollbar-thumb { background: var(--gold); }
  .jt__step { scroll-snap-align: start; }

  .jt__card {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    isolation: isolate;
  }
  .jt__media { display: block; height: 100%; }
  .jt__media :global(img) { width: 100%; height: 100%; object-fit: cover; }

  /* The caption sits over the photograph and fades in on hover or focus. */
  .jt__body {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    align-content: end;
    gap: 0.45rem;
    padding: clamp(1.1rem, 2.2vw, 1.75rem);
    color: var(--paper);
    background: linear-gradient(
      to top,
      rgb(6 5 4 / 0.9) 0%,
      rgb(6 5 4 / 0.72) 45%,
      rgb(6 5 4 / 0.4) 75%,
      rgb(6 5 4 / 0.25) 100%
    );
    opacity: 0;
    transition: opacity 0.5s var(--ease);
  }
  .jt__card:hover .jt__body,
  .jt__card:focus-visible .jt__body,
  .jt__card:focus-within .jt__body { opacity: 1; }

  .jt__n { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.2em; color: var(--gold-300); }
  .jt__body h3 { color: inherit; }
  .jt__body p {
    font-size: var(--step--1);
    line-height: 1.5;
    color: color-mix(in srgb, var(--paper) 82%, transparent);
  }

  /* Touch devices have no hover, so the caption is always shown there. */
  @media (hover: none) {
    .jt__body { opacity: 1; }
  }
  /* Nor is a fade useful if the visitor has asked for less motion. */
  @media (prefers-reduced-motion: reduce) {
    .jt__body { transition: none; }
  }

  .jt__hint {
    padding-inline: var(--gutter);
    margin-top: 0.5rem;
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (min-width: 62rem) {
    .jt__track { grid-auto-columns: 22rem; }
  }
</style>
