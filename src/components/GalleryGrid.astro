---
import Ph from './Ph.astro';
import { galleryItems } from '../data/gallery';

interface Props { limit?: number }
const { limit } = Astro.props;
const items = limit ? galleryItems.slice(0, limit) : galleryItems;
---

<ul class="gg">
  {items.map((key, i) => (
    <li class="gg__cell reveal" style={`--reveal-delay:${(i % 4) * 70}ms`}>
      <span class="media media--zoom">
        <Ph
          name={key}
          sizes="(min-width: 75rem) 24vw, (min-width: 48rem) 32vw, 48vw"
          widths={[320, 480, 680, 900, 1200]}
        />
      </span>
    </li>
  ))}
</ul>

<style>
  /* Multi-column masonry: heights balance on their own, so no tessellation holes. */
  .gg {
    list-style: none;
    margin: 0;
    padding: 0;
    --gg-gap: clamp(0.4rem, 0.9vw, 0.75rem);
    column-count: 2;
    column-gap: var(--gg-gap);
  }
  @media (min-width: 48rem) { .gg { column-count: 3; } }
  @media (min-width: 75rem) { .gg { column-count: 4; } }

  .gg__cell {
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
    margin-bottom: var(--gg-gap);
  }
  .gg__cell > span { display: block; }
  .gg__cell :global(img) { width: 100%; height: auto; }
</style>
