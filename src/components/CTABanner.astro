---
import Ph from './Ph.astro';

interface Props {
  photo?: string;
  eyebrow?: string;
  title: string;
  body?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
}
const {
  photo = 'stage-warm',
  eyebrow = 'Join Fanatic Arts',
  title,
  body,
  primary = { label: 'Enquire about lessons', href: '/contact/' },
  secondary,
} = Astro.props;
---

<section class="cta">
  <div class="cta__media media scrim">
    <Ph name={photo} alt="" sizes="100vw" widths={[640, 960, 1400, 1920, 2200]} />
  </div>
  <div class="wrap cta__body reveal">
    <p class="cta__eyebrow">{eyebrow}</p>
    <h2 class="display display--l">{title}</h2>
    {body && <p class="cta__lede">{body}</p>}
    <div class="cta__actions">
      <a class="btn btn--gold" href={primary.href}>{primary.label} <span class="arw" aria-hidden="true">→</span></a>
      {secondary && <a class="btn btn--ghost" href={secondary.href}>{secondary.label}</a>}
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    display: grid;
    place-items: center;
    text-align: center;
    color: var(--paper);
    min-height: clamp(28rem, 72svh, 44rem);
    isolation: isolate;
    overflow: clip;
  }
  .cta__media { position: absolute; inset: 0; z-index: -1; }
  .cta__media :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .cta__body {
    display: grid;
    justify-items: center;
    gap: clamp(1rem, 2vw, 1.6rem);
    padding-block: clamp(4rem, 10vw, 7rem);
  }
  .cta__eyebrow {
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-200);
  }
  .cta h2 { max-width: 16ch; }
  .cta__lede {
    max-width: 50ch;
    font-size: var(--step-1);
    color: color-mix(in srgb, var(--paper) 80%, transparent);
  }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 0.85rem; justify-content: center; margin-top: 0.5rem; }
</style>
