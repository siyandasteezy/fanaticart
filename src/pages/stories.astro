---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import CTABanner from '../components/CTABanner.astro';
import Ph from '../components/Ph.astro';
import { site } from '../data/site';

/**
 * Pathways describe the routes a learner can take through the academy.
 * They are deliberately NOT presented as named individuals — the photography
 * on this site is licensed placeholder work, not Fanatic Arts learners.
 */
const pathways = [
  {
    n: '01',
    title: 'The young learner',
    body: 'Starts in the foundation phase with rhythm, movement and storytelling. Moves into structured performance, then chooses a specialisation in high school.',
    photo: 'g-xylophone-boy',
  },
  {
    n: '02',
    title: 'The specialist',
    body: 'Commits to one discipline and goes deep — technique, ensemble, repertoire and a portfolio built for auditions, industry and higher education.',
    photo: 'g-sax-portrait',
  },
  {
    n: '03',
    title: 'The educator & entrepreneur',
    body: 'Trains toward teaching under the Mpanziq syllabus, or toward running productions, studios and creative businesses of their own.',
    photo: 'journey-collaborate',
  },
];
---

<BaseLayout
  title="Stories"
  description={`The story of ${site.name} — founded ${site.founded}, built through Fanatic Reproduction and Fanatic Productions into a multidisciplinary arts institution.`}
  transparentHeader
>
  <PageHero
    eyebrow="Stories & impact"
    title="A vision that took seventeen years to build properly."
    lede="Fanatic Arts did not start as an institution. It started as a calling, and it was shaped by every stage it passed through."
    photo="backstage"
    focus="center 50%"
  />

  <section class="section">
    <div class="wrap story">
      <div class="story__lead reveal">
        <p class="eyebrow">The origin</p>
        <h2 class="display display--m">From a calling to an institution.</h2>
      </div>

      <div class="story__body reveal" style="--reveal-delay:100ms">
        <p class="story__first">
          Fanatic Arts was founded from a deep-rooted spiritual calling and a lifelong
          commitment to the arts. The vision began in {site.founded}, long before the
          organisation was formally structured.
        </p>
        <p>
          It evolved through several developmental stages — <strong>Fanatic Reproduction</strong>,
          <strong>Fanatic Productions</strong>, and ultimately <strong>Fanatic Arts</strong> — each one
          reflecting increased clarity, scope and alignment with its founding mandate.
        </p>
        <p>
          What emerged is an organisation that refuses the usual split between teaching art
          and making a living from it. Education sits at the centre; performance, production,
          visual services and apparel grow out of it. Learners are trained not only to be good
          at the craft, but to be able to work in it.
        </p>
        <p>
          That mandate now reaches children and youth, young professionals and emerging
          creatives, adult and senior learners, and the schools, churches and community
          institutions that partner with the academy.
        </p>
      </div>
    </div>
  </section>

  <section class="section on-dark">
    <div class="wrap">
      <SectionHead
        eyebrow="Pathways"
        title="Three routes through the same institution."
        lede="Different starting points, different destinations — one standard of training."
        class="reveal"
      />
      <ul class="pw">
        {pathways.map((p, i) => (
          <li class="reveal" style={`--reveal-delay:${i * 100}ms`}>
            <span class="pw__media media media--zoom">
              <Ph name={p.photo} alt="" sizes="(min-width: 62rem) 30vw, (min-width: 40rem) 46vw, 92vw" widths={[380, 560, 780, 1050]} />
            </span>
            <span class="pw__n">{p.n}</span>
            <h3 class="display display--s">{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap soon">
      <div class="soon__inner reveal">
        <p class="eyebrow">Coming soon</p>
        <h2 class="display display--s">Learner and production stories</h2>
        <p>
          This is where Fanatic Arts learners, alumni, productions and partner schools will
          be featured — in their own words, with their own photography. Until that work is
          documented, the imagery on this site is licensed placeholder photography and does
          not depict Fanatic Arts learners, staff, facilities or productions.
        </p>
        <p class="soon__meta">
          Have a story to contribute? <a href="/contact/">Get in touch.</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow="Impact" title="What it adds up to." class="reveal" />
      <ul class="impact reveal">
        <li>Preservation of artistic and cultural heritage</li>
        <li>Youth empowerment and skills development</li>
        <li>Job creation within the creative industries</li>
        <li>Faith-based influence in arts and culture</li>
        <li>Long-term generational legacy</li>
      </ul>
    </div>
  </section>

  <CTABanner
    photo="journey-perform"
    title="Be part of the next chapter."
    body="Enrol, partner, or bring Fanatic Arts to your community."
    primary={{ label: 'Get in touch', href: '/contact/' }}
  />
</BaseLayout>

<style>
  .story { display: grid; gap: clamp(2rem, 5vw, 4rem); }
  @media (min-width: 62rem) { .story { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); } }
  .story__lead { display: grid; gap: 1.1rem; align-content: start; }
  .story__body { display: grid; gap: 1.35rem; max-width: 62ch; color: var(--muted); }
  .story__first { font-size: var(--step-1); line-height: 1.5; color: var(--fg); }
  .story__body strong { color: var(--fg); font-weight: 600; }

  .pw {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 40rem) { .pw { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 62rem) { .pw { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .pw li { display: grid; gap: 0.6rem; align-content: start; }
  .pw__media { display: block; aspect-ratio: 4 / 5; margin-bottom: 0.9rem; }
  .pw__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .pw__n { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.2em; color: var(--gold-300); }
  .pw p { font-size: var(--step--1); color: var(--muted); }

  .soon__inner {
    border: 1px solid var(--rule);
    border-left: 3px solid var(--gold);
    padding: clamp(1.75rem, 4vw, 3rem);
    display: grid;
    gap: 1rem;
    max-width: 62rem;
  }
  .soon__inner p { color: var(--muted); max-width: 62ch; }
  .soon__meta { font-size: var(--step--1); }

  .impact { list-style: none; margin: clamp(2rem, 4vw, 3rem) 0 0; padding: 0; max-width: 46rem; }
  .impact li {
    padding-block: 1.1rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-display);
    font-size: var(--step-1);
    letter-spacing: -0.015em;
  }
</style>
